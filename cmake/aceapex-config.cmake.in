@PACKAGE_INIT@
# find_package(aceapex CONFIG): target aceapex::aceapex (library, header aceapex.h)
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@ACEAPEX_ZSTD_CONFIG@)
  find_dependency(zstd CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/aceapex-targets.cmake")
check_required_components(aceapex)
